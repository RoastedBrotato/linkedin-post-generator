# ============================================
# Environment Configuration
# ============================================
ENVIRONMENT=development  # development, production
DEBUG=false

# ============================================
# LLM Configuration
# ============================================
LLM_PROVIDER=ollama  # ollama, openai, vllm, lmstudio
LLM_API_URL=http://localhost:11434
LLM_MODEL=llama2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=120

# OpenAI Fallback (optional)
# LLM_OPENAI_API_KEY=sk-...
# LLM_OPENAI_MODEL=gpt-4

# ============================================
# LinkedIn API Configuration
# ============================================
# OAuth 2.0 Credentials (get from LinkedIn Developer Portal)
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback

# Access Tokens (generated after OAuth flow - run scripts/linkedin_oauth.py)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_TOKEN_EXPIRES_AT=
LINKEDIN_USER_URN=

# ============================================
# Trend Sources Configuration
# ============================================
# Hacker News
TRENDS_HACKERNEWS_ENABLED=true
TRENDS_HACKERNEWS_MIN_SCORE=100

# Reddit
TRENDS_REDDIT_ENABLED=true
TRENDS_REDDIT_CLIENT_ID=your_reddit_client_id
TRENDS_REDDIT_CLIENT_SECRET=your_reddit_client_secret

# GitHub Trending
TRENDS_GITHUB_ENABLED=true

# arXiv Papers
TRENDS_ARXIV_ENABLED=true

# Fetch Interval
TRENDS_FETCH_INTERVAL_HOURS=6

# ============================================
# Post Generation Configuration
# ============================================
POST_MIN_LENGTH=200
POST_MAX_LENGTH=3000
POST_MAX_HASHTAGS=5
POST_GENERATION_INTERVAL_HOURS=24
POST_POSTS_PER_BATCH=3
POST_MIN_TREND_RELEVANCE=0.5

# ============================================
# Storage Configuration
# ============================================
STORAGE_DATABASE_PATH=data/database.db
STORAGE_POSTS_DIR=data/posts
STORAGE_LOGS_DIR=logs
STORAGE_CLEANUP_OLD_TRENDS_DAYS=30

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# ============================================
# Notification Configuration (Optional)
# ============================================
NOTIFICATION_ENABLED=false

# Email Notifications
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMTP_HOST=smtp.gmail.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=your_email@gmail.com
NOTIFICATION_SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL_FROM=your_email@gmail.com
NOTIFICATION_EMAIL_TO=your_email@gmail.com

# Slack Notifications
NOTIFICATION_SLACK_ENABLED=false
NOTIFICATION_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# LinkedIn Engagement (Scraping + Commenting)
# ============================================
ENGAGE_ENABLED=false
ENGAGE_HEADLESS=true
ENGAGE_COOKIES_PATH=data/linkedin_cookies.json
ENGAGE_MAX_TARGETS=3
ENGAGE_KEYWORDS=AI, machine learning, LLM, MLOps
ENGAGE_INFLUENCERS=
ENGAGE_COMMENT_MAX_CHARS=240
