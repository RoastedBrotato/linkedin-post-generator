---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:8000";
---
<Base title="Scheduled Posts - BrotatosLab">
  <PageHero
    title="Scheduled Posts"
    subtitle="View and manage your scheduled LinkedIn posts."
  />

  <section class="panel">
    <div class="schedule-controls">
      <label for="daysAhead">Show posts for the next:</label>
      <select id="daysAhead">
        <option value="7">7 days</option>
        <option value="14">14 days</option>
        <option value="30" selected>30 days</option>
        <option value="60">60 days</option>
        <option value="90">90 days</option>
      </select>
      <button class="button secondary" onclick="refreshSchedule()">Refresh</button>
    </div>

    <div id="scheduleContainer">
      <p class="mono">Loading scheduled posts...</p>
    </div>
  </section>

  <script define:vars={{ apiBase }}>
    const API_BASE = apiBase;
    let scheduledPosts = [];

    async function loadScheduledPosts() {
      const container = document.getElementById("scheduleContainer");
      const daysAhead = document.getElementById("daysAhead").value;

      try {
        const response = await fetch(`${API_BASE}/api/scheduled-posts?days_ahead=${daysAhead}`);
        if (!response.ok) throw new Error("Failed to load scheduled posts");

        const data = await response.json();
        scheduledPosts = data.scheduled_posts || [];

        if (scheduledPosts.length === 0) {
          container.innerHTML = `
            <div class="empty-state">
              <p>No posts scheduled in the next ${daysAhead} days.</p>
              <a href="/posts" class="button">View All Posts</a>
            </div>
          `;
          return;
        }

        renderSchedule(scheduledPosts);
      } catch (error) {
        container.innerHTML = `
          <div class="error">
            <h3>Error Loading Schedule</h3>
            <p>${error.message}</p>
          </div>
        `;
      }
    }

    function renderSchedule(posts) {
      const container = document.getElementById("scheduleContainer");

      // Group posts by date
      const postsByDate = {};
      posts.forEach(post => {
        const date = new Date(post.scheduled_for).toLocaleDateString();
        if (!postsByDate[date]) {
          postsByDate[date] = [];
        }
        postsByDate[date].push(post);
      });

      // Sort dates
      const sortedDates = Object.keys(postsByDate).sort((a, b) => {
        return new Date(a) - new Date(b);
      });

      let html = '<div class="schedule-timeline">';

      sortedDates.forEach(date => {
        const datePosts = postsByDate[date];
        html += `
          <div class="schedule-day">
            <div class="day-header">
              <h3>${formatDateHeader(date)}</h3>
              <span class="post-count">${datePosts.length} post${datePosts.length !== 1 ? 's' : ''}</span>
            </div>
            <div class="day-posts">
        `;

        datePosts.forEach(post => {
          const time = new Date(post.scheduled_for).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          html += `
            <div class="scheduled-post-card">
              <div class="post-time">${time}</div>
              <div class="post-content">
                <h4>${post.trend_title || 'Untitled'}</h4>
                <p class="post-preview">${truncate(post.content, 150)}</p>
                ${post.hashtags ? `<p class="post-hashtags">${post.hashtags}</p>` : ''}
              </div>
              <div class="post-actions">
                <a href="/posts/${post.id}" class="button secondary small">Edit</a>
                <button class="button secondary small" onclick="unschedulePost(${post.id})">Unschedule</button>
              </div>
            </div>
          `;
        });

        html += `
            </div>
          </div>
        `;
      });

      html += '</div>';
      container.innerHTML = html;
    }

    function formatDateHeader(dateString) {
      const date = new Date(dateString);
      const today = new Date();
      const tomorrow = new Date(today);
      tomorrow.setDate(tomorrow.getDate() + 1);

      const dateStr = date.toDateString();
      if (dateStr === today.toDateString()) {
        return `Today - ${date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}`;
      } else if (dateStr === tomorrow.toDateString()) {
        return `Tomorrow - ${date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}`;
      } else {
        return date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
      }
    }

    function truncate(text, maxLength) {
      if (!text) return '';
      if (text.length <= maxLength) return text;
      return text.substring(0, maxLength) + '...';
    }

    window.unschedulePost = async function(postId) {
      if (!confirm("Unschedule this post?")) return;

      try {
        const response = await fetch(`${API_BASE}/api/posts/${postId}/schedule`, {
          method: "DELETE"
        });

        if (!response.ok) throw new Error("Failed to unschedule post");

        alert("Post unscheduled successfully!");
        loadScheduledPosts();
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    };

    window.refreshSchedule = function() {
      loadScheduledPosts();
    };

    // Handle days ahead selection change
    document.getElementById("daysAhead").addEventListener("change", () => {
      loadScheduledPosts();
    });

    // Load on page load
    loadScheduledPosts();
  </script>

  <style>
    .schedule-controls {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
      padding: 1rem;
      background: var(--bg-light);
      border-radius: 8px;
    }

    .schedule-controls label {
      font-weight: bold;
    }

    .schedule-controls select {
      padding: 0.5rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--bg);
      color: var(--fg);
    }

    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
    }

    .empty-state p {
      margin-bottom: 1rem;
      color: var(--muted);
    }

    .schedule-timeline {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .schedule-day {
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }

    .day-header {
      background: var(--bg-light);
      padding: 1rem 1.5rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .day-header h3 {
      margin: 0;
      font-size: 1.1rem;
    }

    .post-count {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .day-posts {
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .scheduled-post-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 1rem;
      padding: 1rem;
      background: var(--bg-light);
      border: 1px solid var(--border);
      border-radius: 8px;
      align-items: start;
    }

    .post-time {
      font-weight: bold;
      color: var(--accent);
      font-size: 1rem;
      min-width: 80px;
    }

    .post-content h4 {
      margin: 0 0 0.5rem 0;
      font-size: 1rem;
    }

    .post-preview {
      margin: 0.5rem 0;
      color: var(--muted);
      line-height: 1.5;
    }

    .post-hashtags {
      margin: 0.5rem 0 0 0;
      color: var(--accent);
      font-size: 0.9rem;
    }

    .post-actions {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .button.small {
      padding: 0.4rem 0.8rem;
      font-size: 0.85rem;
      white-space: nowrap;
    }

    @media (max-width: 768px) {
      .scheduled-post-card {
        grid-template-columns: 1fr;
      }

      .post-actions {
        flex-direction: row;
      }
    }
  </style>
</Base>
